<?xml version="1.0" encoding="utf-8"?>
<!-- The test SP of the release smoke test, see docs/release.md. It holds no key: infra/deploy/smoke-sso.mjs sends its AuthnRequest
     unsigned and reads the Response itself, so nothing ever posts to the ACS, and .invalid never resolves (RFC 2606). -->
<md:EntityDescriptor xmlns:md="urn:oasis:names:tc:SAML:2.0:metadata" entityID="https://release-smoke.invalid/saml/metadata">
  <md:SPSSODescriptor AuthnRequestsSigned="false" WantAssertionsSigned="true" protocolSupportEnumeration="urn:oasis:names:tc:SAML:2.0:protocol">
    <md:NameIDFormat>urn:oasis:names:tc:SAML:2.0:nameid-format:persistent</md:NameIDFormat>
    <md:AssertionConsumerService Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST" Location="https://release-smoke.invalid/saml/acs" index="0" isDefault="true"/>
  </md:SPSSODescriptor>
</md:EntityDescriptor>
