# The settings of a machine whose own proxy already holds 80 and 443 and passes *.idp.test through to the Traefik of idp, see
# "A server behind its own proxy" in dev-tools/README.md. Copy it to .env in the root of the checkout: compose and the Makefile
# read that file, a machine without it keeps the defaults.
IDP_HTTP_PUBLISH=127.0.0.1:8180
IDP_HTTPS_PUBLISH=127.0.0.1:8443
IDP_GRAFANA_PORT=3001
# The folder of the rootCA.pem that signed dev-tools/certs, when the CA lives on another machine:
# CAROOT=/path/to/the/ca
